

# HousePlanner-Web Environment Variables
# Firebase Configuration (used only for Authentication on the client side)
# IMPORTANT: Get these values from your Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ai-house-planner-43ebd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-house-planner-43ebd
VITE_FIREBASE_STORAGE_BUCKET=ai-house-planner-43ebd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ASP.NET Core Backend API Configuration
VITE_API_BASE_URL=https://localhost:7193/api/v1
